import "package.con"

var state = [=]

func main() {
  for line in story.script {
    match line {
      Text(text) {
        var replaced = text
        for (key, value) in state {
          replaced = replaced.replace("\{{key}}", value)
        }
        print(replaced)
      }
      Pause => try input("> ")
      Input(key) => state[key] = try input("{key}: ")
    }
  }
}

enum StoryLine {
  Text(text: String)
  Pause
  Input(key: String)
}

ref class Story(script: StoryLine[], var position = 0)

try main()
