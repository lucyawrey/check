bracket_on_new_line = "[Put the `{` or `(` on the same line as the declaration before it]"
replaces_std_method = "[a method that replaces a `check:std` method of the same name]"

// Command line
tidy_summary = "[Made {fixes} fixes in {files} files]"
tidy_errors_remain = "[Style fixes were skipped, because there are errors tidy can't fix]"
tidy_too_many_passes = "[Tidy stopped after 10 passes with fixes still left, and changed nothing]"
tidy_dry_run = "[Found fixes to make, and left the files unchanged]"
calls_left_out = "[{count} calls left out]"
con_value_unsupported = "[A `.con` file can't hold this value]"
