// Editor
hint_ref_argument = "ref"
hint_shared_argument = "shared"
hint_try_returns = "[If this fails, `try` returns from the function here]"
detail_or_shared = "[or declare it with `shared`]"
detail_already_shared = "[It's declared `shared`, so it already reads as its value: leave out `.value`]"
fix_title = "[Fix this]"
fix_all_title = "[Fix everything tidy can fix in this file]"

// Diagnostics
unknown_character = "[This character isn't part of Check]"
unclosed_string = "[This string has no closing quote]"
unknown_escape = "[This escape isn't one Check knows]"
unclosed_interpolation = "[This `{` in a string has no closing `}`, or nothing inside it]"
leading_zero = "[Numbers can't start with 0 followed by more digits]"
malformed_number = "[This number isn't written correctly]"
unexpected_token = "[Check didn't expect this here]"
unclosed_bracket = "[This bracket is never closed]"
trailing_separator = "[Leave out the `,` or `;` here]"
else_on_new_line = "[Put `else` on the same line as the `}` before it]"
foreign_operator = "[This operator is from another language]"
assignment_in_condition = "[This `=` sets a value: use `==` to compare]"
arrow_without_braces = "[A function with `->` needs its body in braces]"
arrow_before_braces = "[A body in braces doesn't need `=>`]"
body_without_arrow = "[A body without braces needs `=>` before it]"
var_in_declaration_pattern = "[`var` can't go inside a `let` or `var` pattern]"
let_in_class_header = "[Fields in a class header are `let` already: leave out `let`]"
readonly_let = "[A `let` field is already read-only: leave out `readonly`]"
arrow_on_new_line = "[Start a `=>` body on the same line as the `=>`]"
semicolon_in_arrow_body = "[A `=>` body holds one statement: use braces for more]"
unknown_name = "[Nothing has this name]"
duplicate_name = "[This name is already used here]"
redefined_builtin = "[This name is reserved by Check]"
used_before_declared = "[This variable is used before the line that declares it]"
used_before_set = "[This runs a function before a top-level variable it uses is set]"
unset_read = "[This variable might not have a value yet]"
let_set_twice = "[This `let` might already have a value, and a `let` can only be set once]"
top_level_without_value = "[A top-level `let` or `var` needs a value]"
nested_named_function = "[A named function can't be declared inside another function: use a lambda]"
type_mismatch = "[This isn't the type expected here]"
type_needed = "[Check can't work out this type: write it out]"
wrong_arguments = "[This call has the wrong number of arguments, or a name that isn't a parameter]"
unknown_method = "[This type has no method with this name]"
not_callable = "[This isn't a function, so it can't be called]"
invalid_operand_types = "[This operator doesn't work on these types]"
bitwise_on_bool = "[Use `and`, `or` or `not` on Bools]"
chained_comparison = "[Comparisons can't be chained: join them with `and`]"
slash_for_int = "[`/` gives a Float: use `div` for an Int]"
branch_type_mismatch = "[The `if` and `else` branches give different types]"
return_type_mismatch = "[This function returns different types on different paths]"
recursion_without_return_type = "[A function that calls itself needs its return type written]"
literal_too_big = "[This number is too big for its type]"
negative_literal_exponent = "[An Int can't be raised to a negative power]"
unhandled_maybe = "[This might be `None`: handle that case first]"
doubled_maybe = "[This gives a `T??` where a `T?` is expected]"
not_iterable = "[`for` can only go through a list, range, map or set]"
invalid_key_type = "[Map keys and set items need a type that compares exactly]"
try_outside_failable = "[`try` only works in a function that returns a Maybe or a Result]"
try_result_in_maybe = "[This function returns a Maybe, so `try` can't pass a Result's error up]"
try_maybe_in_result = "[This function returns a Result, so `try` on a Maybe needs an error to pass up]"
try_error_mismatch = "[This error type doesn't match the one the function returns]"
assign_to_let = "[This is a `let`, so it can't be changed: declare it with `var`]"
assign_to_captured = "[A lambda captured this variable, so it can't be changed]"
overlapping_ref = "[Two arguments of this call point to the same place]"
ref_default = "[A `ref` parameter can't have a default]"
ref_func_as_value = "[A function with `ref` or `shared` parameters can't be used as a value]"
shared_where_value_expected = "[This is a `Shared`: use `.value` to read it]"
changed_in_for_ref = "[This changes the list that the `for ref` loop is going through]"
assign_to_parameter = "[This parameter can't be changed: write it as `var`]"
change_let_collection = "[This list, map or set is a `let`, so it can't be changed]"
changes_let = "[This method changes its value, which is a `let`]"
missing_shared = "[This parameter is `shared`, so it needs a `shared` value]"
not_shared = "[`shared` goes before a shared local, parameter or field]"
ref_binding_overlap = "[Change this only through its `ref` binding while that binding exists]"
ref_binding_captured = "[A lambda can't capture a `ref` binding]"
interface_changes_this = "[An interface method can't change `this` for now]"
break_outside_loop = "[`break` and `continue` only work inside a loop]"
return_outside_function = "[`return` only works inside a function]"
loop_value_without_break = "[This loop is used as a value, so it needs a `break` with one]"
break_type_mismatch = "[These `break` values have different types]"
constant_backwards_range = "[This range goes backwards, so it's empty]"
nested_type = "[A class or enum can't be declared inside a function]"
mixed_fields = "[Fields here must be all named or all by position]"
record_to_class = "[A record can't be used where a class is expected]"
spread_not_first = "[A `...` spread must come first, and only once]"
this_outside_method = "[`this` only works inside a method]"
unknown_field = "[This type has no field with this name]"
unqualified_variant = "[Write this variant with its enum's name, since the type isn't known here]"
non_exhaustive_match = "[This `match` misses a case]"
or_pattern_bindings = "[Each choice in this pattern must bind the same names]"
let_else_can_finish = "[The `else` of a `let`-`else` must leave the block, with `return`, `break` or similar]"
const_not_constant = "[A `const` needs a value that's known before the program runs]"
const_cycle = "[These consts are defined in terms of each other]"
missing_import = "[There's no file or folder at this path]"
folder_without_slash = "[A folder import ends with `/`]"
imported_entry_file = "[This file has its own imports or top-level code, so it can't be imported]"
overlapping_imports = "[These two imports both include the same file]"
private_import_in_run = "[`import private` only works in tests]"
ambiguous_name = "[This name is in more than one namespace: write which one]"
private_name = "[This is private to its unit]"
private_member = "[This is private to its type]"
readonly_field = "[This field is `readonly`, so it can only be set inside its class]"
private_field_without_default = "[A private field needs a default]"
wrong_type_arguments = "[This type takes a different number of type arguments]"
not_an_interface = "[This type isn't an interface]"
unmet_constraint = "[This type doesn't implement the interfaces it needs to here]"
missing_implementation = "[This type is missing something its interface requires]"
wrong_implementation = "[These types don't match the interface's]"
conflicting_defaults = "[Two interfaces give this method different defaults: write it here]"
field_requirement_needs_class = "[This interface requires fields, so only a class can implement it]"
implement_for_specific_arguments = "[An interface has to be implemented for every version of a generic type]"
bound_on_concrete_type = "[a bound in an `implement` target on a type, not a parameter]"
list_needs_type = "[This list mixes types: write its element type]"
interface_field_extras = "[An interface field can't have a default, or be private or readonly]"
code_in_pure_data = "[A `.con` file can only hold values, not code]"
missing_manifest = "[This folder has no `package.con`]"
no_entry = "[This `package.con` doesn't say which file to run]"
missing_entry = "[The entry file in `package.con` doesn't exist]"
misplaced_host_import = "[`import host` can only appear once, and not beside a `package.con`]"
unknown_host = "[There's no host with this name]"
unsupported_import = "[`pkg:` and URL imports aren't supported yet]"
wasm_unsupported = "[this isn't supported when compiling to WASM yet]"
import_cycle = "[These units import each other in a loop]"
data_folder = "[This folder holds only data files: read it as a Map]"
bad_data_name = "[This data file's name isn't a valid name]"
not_pure_data = "[A data file read by a host has to be a `.con` or `.json` file]"
json_syntax = "[This isn't valid JSON]"
unknown_variant = "[The enum has no variant with this name]"
missing_tag = "[A JSON object for an enum needs a `type` key naming its variant]"
namespace_outside_package = "[This namespace has to start with its package's]"
misplaced_namespace = "[A `namespace` line has to be the file's first line]"
external_outside_library = "[`external` functions only work in a library package]"
try_stopped = "[A top-level `try` found `None` or an error, so the program stopped]"
panic_called = "[The program called `panic`]"
integer_overflow = "[This number got too big for an Int]"
division_by_zero = "[Dividing by zero]"
or_panic_on_none = "[`orPanic` found `None`]"
or_panic_on_err = "[`orPanic` found an error]"
negative_exponent = "[An Int can't be raised to a negative power]"
shift_out_of_range = "[This shift is too big or negative]"
round_out_of_range = "[This Float is too big, or not a number, to round to an Int]"
stack_overflow = "[More than 10,000 calls are nested here]"
internal_error = "[This is a bug in Check, not in your code]"
out_of_steps = "[This const or data value took too long to work out]"
data_try_failed = "[A `try` failed while building this data value]"
missing_key = "[This map has no such key]"
index_out_of_range = "[This list has no such index]"
for_ref_element_gone = "[This item was removed before the `for ref` loop could write it back]"
unused_var = "[This `var` is never changed: make it a `let`]"
changed_copy = "[This changes a copy that's never used again]"
shared_wraps_shared_class = "[A shared class is shared already, so it doesn't need `Shared`]"
ref_param_of_shared_class = "[A shared class is shared already, so it doesn't need `ref`]"
shadowed_name = "[This local hides a function or type with the same name]"
interpolated_maybe = "[This might be `None`, which prints as `None`]"
nested_maybe = "[This gives a `T??`]"
let_else_some = "[`??` can replace this `let Some`-`else`]"
