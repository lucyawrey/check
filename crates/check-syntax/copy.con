set_in_every_branch = "[Every branch sets this, so it can be set where it's declared]"
nested_try = "[The outer `try` already covers this]"
compound_on_missing_index = "[This index might not exist, so it can't be changed in place]"
ref_changed_elsewhere = "[Something else changed this `ref` argument's place during the call]"
ref_global_written = "[This function also changes this global, so it can't be passed as `ref`]"
record_beside_class = "[The class is already written beside this record: leave it out]"
