// Editor
// Editor inlay hint before an argument passed to a `ref` parameter
hint_ref_argument = "ref"
// Editor inlay hint before an argument passed to a `shared` parameter
hint_shared_argument = "shared"
// Editor hint on a `try`, marking where the function can return early
hint_try_returns = "[If this fails, `try` returns from the function here]"
// Added to shared_where_value_expected's message when the value is a local used with an operator
detail_or_shared = "[or declare it with `shared`]"
// Added to unknown_field's message when `.value` is read on something already declared `shared`
detail_already_shared = "[It's declared `shared`, so it already reads as its value: leave out `.value`]"
// Editor quick-fix menu: apply the fix for one problem
fix_title = "[Fix this]"
// Editor quick-fix menu: apply every tidy fix in the file
fix_all_title = "[Fix everything tidy can fix in this file]"

// Diagnostics
// Error: a character the lexer doesn't recognize, like `$`
unknown_character = "[This character isn't part of Check]"
// Error: a string literal reaches the end of the line without a closing quote
unclosed_string = "[This string has no closing quote]"
// Error: a backslash escape in a string that isn't supported, like `\q`
unknown_escape = "[This escape isn't one Check knows]"
// Error: a `{` in a string with no `}`, or `{}` with nothing inside
unclosed_interpolation = "[This `{` in a string has no closing `}`, or nothing inside it]"
// Error: a number like `007`
leading_zero = "[Numbers can't start with 0 followed by more digits]"
// Error: a number written wrong, like `12px`
malformed_number = "[This number isn't written correctly]"
// Error: the parser hit something it can't make sense of here
unexpected_token = "[Check didn't expect this here]"
// Error: an opening `(`, `[` or `{` with no closing match
unclosed_bracket = "[This bracket is never closed]"
// Error with a fix: a `,` or `;` at the end of a line or before a closing bracket
trailing_separator = "[Leave out the `,` or `;` here]"
// Error: `else` starts a new line instead of following the `}`
else_on_new_line = "[Put `else` on the same line as the `}` before it]"
// Error: an operator from other languages, like `&&`, `||`, `!` or `%`
foreign_operator = "[This operator is from another language]"
// Error: `=` used in an `if` or `while` condition where `==` was likely meant
assignment_in_condition = "[This `=` sets a value: use `==` to compare]"
// Error: a function with a `-> Type` return has a `=>` body instead of braces
arrow_without_braces = "[A function with `->` needs its body in braces]"
// Error: `=>` written before a body in braces
arrow_before_braces = "[A body in braces doesn't need `=>`]"
// Error: a function body without braces and without `=>`
body_without_arrow = "[A body without braces needs `=>` before it]"
// Error: `var` written inside a destructuring `let` or `var` pattern
var_in_declaration_pattern = "[`var` can't go inside a `let` or `var` pattern]"
// Error with a fix: `let` written on a field in a class header, `class P(let x: Int)`
let_in_class_header = "[Fields in a class header are `let` already: leave out `let`]"
// Error with a fix: `readonly let`, since a `let` field is already read-only
readonly_let = "[A `let` field is already read-only: leave out `readonly`]"
// Error: a `=>` body starts on the line after the `=>`
arrow_on_new_line = "[Start a `=>` body on the same line as the `=>`]"
// Error: a `;` in a `=>` body, trying to fit more than one statement
semicolon_in_arrow_body = "[A `=>` body holds one statement: use braces for more]"
// Error: a name that isn't declared anywhere in scope
unknown_name = "[Nothing has this name]"
// Error: a name declared twice in the same scope
duplicate_name = "[This name is already used here]"
// Error: declaring a name that belongs to Check, like `Int` or `print`
redefined_builtin = "[This name is reserved by Check]"
// Error: a variable read on a line above its declaration
used_before_declared = "[This variable is used before the line that declares it]"
// Error: a call at top level runs a function that reads a top-level variable not set yet
used_before_set = "[This runs a function before a top-level variable it uses is set]"
// Error: reading a variable that some path leaves without a value
unset_read = "[This variable might not have a value yet]"
// Error: a `let` declared without a value is set on a path that may have set it already
let_set_twice = "[This `let` might already have a value, and a `let` can only be set once]"
// Error: a top-level `let` or `var` declared without a value
top_level_without_value = "[A top-level `let` or `var` needs a value]"
// Error: `func name()` declared inside another function
nested_named_function = "[A named function can't be declared inside another function: use a lambda]"
// Error: a value of the wrong type, like a String passed where an Int is expected
type_mismatch = "[This isn't the type expected here]"
// Error: Check can't infer a type, like a field or parameter with no type and no default
type_needed = "[Check can't work out this type: write it out]"
// Error: a call with too many or too few arguments, or a named argument that doesn't exist
wrong_arguments = "[This call has the wrong number of arguments, or a name that isn't a parameter]"
// Error: calling a method the type doesn't have
unknown_method = "[This type has no method with this name]"
// Error: calling something that isn't a function, like `x()` on an Int
not_callable = "[This isn't a function, so it can't be called]"
// Error: an operator used on types it doesn't support, like `"a" - 1`
invalid_operand_types = "[This operator doesn't work on these types]"
// Error: `&`, `|` or `^` used on Bools
bitwise_on_bool = "[Use `and`, `or` or `not` on Bools]"
// Error: comparisons chained like `a < b < c`
chained_comparison = "[Comparisons can't be chained: join them with `and`]"
// Error: `/` on two Ints where an Int result is expected
slash_for_int = "[`/` gives a Float: use `div` for an Int]"
// Error: an `if` used as a value whose branches give different types
branch_type_mismatch = "[The `if` and `else` branches give different types]"
// Error: a function without a written return type returns different types on different paths
return_type_mismatch = "[This function returns different types on different paths]"
// Error: a function that calls itself with no written return type
recursion_without_return_type = "[A function that calls itself needs its return type written]"
// Error: a number literal too big for its type
literal_too_big = "[This number is too big for its type]"
// Error: an Int raised to a negative literal power, like `2 ** -1`
negative_literal_exponent = "[An Int can't be raised to a negative power]"
// Error: a Maybe (`T?`) used where a plain `T` is needed
unhandled_maybe = "[This might be `None`: handle that case first]"
// Not used in the code at the moment
doubled_maybe = "[This gives a `T??` where a `T?` is expected]"
// Error: `flatten` called on a value that isn't nested, like a `T?` rather than `T??`
flatten_without_nesting = "[There's nothing nested here to flatten]"
// Error: `for` over something that isn't a list, range, map or set
not_iterable = "[`for` can only go through a list, range, map or set]"
// Error: a map key or set item type that doesn't support exact comparison
invalid_key_type = "[Map keys and set items need a type that compares exactly]"
// Error: `try` in a function that doesn't return a Maybe or Result
try_outside_failable = "[`try` only works in a function that returns a Maybe or a Result]"
// Error: `try` on a Result in a function that returns a Maybe
try_result_in_maybe = "[This function returns a Maybe, so `try` can't pass a Result's error up]"
// Error: `try` on a Maybe in a function that returns a Result
try_maybe_in_result = "[This function returns a Result, so `try` on a Maybe needs an error to pass up]"
// Error: `try` on a Result whose error type differs from the function's
try_error_mismatch = "[This error type doesn't match the one the function returns]"
// Error: changing a variable declared with `let`
assign_to_let = "[This is a `let`, so it can't be changed: declare it with `var`]"
// Error: changing a variable that a lambda captured
assign_to_captured = "[A lambda captured this variable, so it can't be changed]"
// Error: one call passes the same place to two parameters, at least one `ref`
overlapping_ref = "[Two arguments of this call point to the same place]"
// Error: a `ref` parameter given a default value
ref_default = "[A `ref` parameter can't have a default]"
// Error: a function with `ref` or `shared` parameters used as a value, like passed to `map`
ref_func_as_value = "[A function with `ref` or `shared` parameters can't be used as a value]"
// Error with a quick fix: a `Shared` used where its value is expected; the fix adds `.value`
shared_where_value_expected = "[This is a `Shared`: use `.value` to read it]"
// Error: changing a list inside a `for ref` loop going through it
changed_in_for_ref = "[This changes the list that the `for ref` loop is going through]"
// Error: changing a parameter not declared `var`
assign_to_parameter = "[This parameter can't be changed: write it as `var`]"
// Error: calling a changing method like `push` on a list, map or set declared with `let`
change_let_collection = "[This list, map or set is a `let`, so it can't be changed]"
// Error: calling a method that changes `this` on a value declared with `let`
changes_let = "[This method changes its value, which is a `let`]"
// Error: passing a plain value to a `shared` parameter
missing_shared = "[This parameter is `shared`, so it needs a `shared` value]"
// Error: `shared` written somewhere it doesn't apply
not_shared = "[`shared` goes before a shared local, parameter or field]"
// Error: changing a value directly while a `ref` binding to it is still in use
ref_binding_overlap = "[Change this only through its `ref` binding while that binding exists]"
// Error: a lambda that captures a `ref` binding
ref_binding_captured = "[A lambda can't capture a `ref` binding]"
// Error: an interface method that changes `this`, not supported yet
interface_changes_this = "[An interface method can't change `this` for now]"
// Error: `break` or `continue` outside a loop
break_outside_loop = "[`break` and `continue` only work inside a loop]"
// Error: `return` at top level
return_outside_function = "[`return` only works inside a function]"
// Not used in the code at the moment
loop_value_without_break = "[This loop is used as a value, so it needs a `break` with one]"
// Error: a loop used as a value whose `break`s give different types
break_type_mismatch = "[These `break` values have different types]"
// Error: a range with constant ends that goes backwards, like `5..1`
constant_backwards_range = "[This range goes backwards, so it's empty]"
// Error: a class or enum declared inside a function
nested_type = "[A class or enum can't be declared inside a function]"
// Error: a record or class mixing named and positional fields
mixed_fields = "[Fields here must be all named or all by position]"
// Error: a record literal passed where a class is expected
record_to_class = "[A record can't be used where a class is expected]"
// Error: a `...` spread that isn't first in a record, or appears twice
spread_not_first = "[A `...` spread must come first, and only once]"
// Error: `this` used outside a method
this_outside_method = "[`this` only works inside a method]"
// Error: reading a field the type doesn't have
unknown_field = "[This type has no field with this name]"
// Error: an enum variant written without its enum name where the type can't be inferred
unqualified_variant = "[Write this variant with its enum's name, since the type isn't known here]"
// Error: a `match` that doesn't cover every case
non_exhaustive_match = "[This `match` misses a case]"
// Error: a pattern with `|` whose choices bind different names
or_pattern_bindings = "[Each choice in this pattern must bind the same names]"
// Error: a `let`-`else` whose `else` block can reach its end
let_else_can_finish = "[The `else` of a `let`-`else` must leave the block, with `return`, `break` or similar]"
// Error: a `const` whose value needs the program running, like a call to a function that isn't constant
const_not_constant = "[A `const` needs a value that's known before the program runs]"
// Error: consts that depend on each other in a loop
const_cycle = "[These consts are defined in terms of each other]"
// Error: an import path that doesn't exist
missing_import = "[There's no file or folder at this path]"
// Error: importing a folder without a trailing `/`
folder_without_slash = "[A folder import ends with `/`]"
// Error: importing a file that has its own imports or top-level code
imported_entry_file = "[This file has its own imports or top-level code, so it can't be imported]"
// Error: two imports that both bring in the same file
overlapping_imports = "[These two imports both include the same file]"
// Error: `import private` outside a test
private_import_in_run = "[`import private` only works in tests]"
// Error: a name found in more than one imported namespace
ambiguous_name = "[This name is in more than one namespace: write which one]"
// Error: using a `private` declaration from another unit
private_name = "[This is private to its unit]"
// Error: using a `private` field or method from outside its type
private_member = "[This is private to its type]"
// Error: setting a `readonly` field from outside its class
readonly_field = "[This field is `readonly`, so it can only be set inside its class]"
// Error: a private field with no default value
private_field_without_default = "[A private field needs a default]"
// Error: a generic type given the wrong number of type arguments, like `List<Int, Int>`
wrong_type_arguments = "[This type takes a different number of type arguments]"
// Error: something other than an interface used as a constraint or in `implement`
not_an_interface = "[This type isn't an interface]"
// Error: a type argument that doesn't implement a required interface
unmet_constraint = "[This type doesn't implement the interfaces it needs to here]"
// Error: a type implementing an interface leaves out one of its members
missing_implementation = "[This type is missing something its interface requires]"
// Error: an interface member implemented with the wrong types
wrong_implementation = "[These types don't match the interface's]"
// Error: two interfaces give the same method different default bodies
conflicting_defaults = "[Two interfaces give this method different defaults: write it here]"
// Error: a record or enum implementing an interface that requires fields
field_requirement_needs_class = "[This interface requires fields, so only a class can implement it]"
// Error: `implement` for one version of a generic type, like `List<Int>`
implement_for_specific_arguments = "[An interface has to be implemented for every version of a generic type]"
// Error: a list literal mixing element types with no written type
list_needs_type = "[This list mixes types: write its element type]"
// Error: an interface field with a default, `private` or `readonly`
interface_field_extras = "[An interface field can't have a default, or be private or readonly]"
// Error: code (functions, calls and so on) in a `.con` data file
code_in_pure_data = "[A `.con` file can only hold values, not code]"
// Error: a package folder with no `package.con`
missing_manifest = "[This folder has no `package.con`]"
// Error: a `package.con` that doesn't name a file to run
no_entry = "[This `package.con` doesn't say which file to run]"
// Error: the entry file named in `package.con` doesn't exist
missing_entry = "[The entry file in `package.con` doesn't exist]"
// Error: `import host` written twice, or in a folder with a `package.con`
misplaced_host_import = "[`import host` can only appear once, and not beside a `package.con`]"
// Error: `import host` with a host name Check doesn't know
unknown_host = "[There's no host with this name]"
// Error: a `pkg:` or URL import, not supported yet
unsupported_import = "[`pkg:` and URL imports aren't supported yet]"
// Error: units that import each other in a loop
import_cycle = "[These units import each other in a loop]"
// Error: importing a folder of only data files as code instead of as a Map
data_folder = "[This folder holds only data files: read it as a Map]"
// Error: a data file whose name can't be used as a Check name
bad_data_name = "[This data file's name isn't a valid name]"
// Error: a host reading a data file that isn't `.con`
not_pure_data = "[A data file read by a host has to be a `.con` file]"
// Error: a `namespace` that doesn't start with its package's namespace
namespace_outside_package = "[This namespace has to start with its package's]"
// Error: a `namespace` line that isn't the file's first line
misplaced_namespace = "[A `namespace` line has to be the file's first line]"
// Error: an `external` function outside a library package
external_outside_library = "[`external` functions only work in a library package]"
// Run-time error: a top-level `try` hit `None` or an error and stopped the program
try_stopped = "[A top-level `try` found `None` or an error, so the program stopped]"
// Run-time error: the program called `panic`
panic_called = "[The program called `panic`]"
// Run-time error: Int arithmetic overflowed
integer_overflow = "[This number got too big for an Int]"
// Run-time error: dividing an Int by zero
division_by_zero = "[Dividing by zero]"
// Run-time error: `orPanic` on `None`
or_panic_on_none = "[`orPanic` found `None`]"
// Run-time error: `orPanic` on an error Result
or_panic_on_err = "[`orPanic` found an error]"
// Run-time error: an Int raised to a negative power that wasn't a literal
negative_exponent = "[An Int can't be raised to a negative power]"
// Run-time error: a bit shift by a negative amount or by 64 or more
shift_out_of_range = "[This shift is too big or negative]"
// Run-time error: rounding a Float to an Int when it's too big or NaN
round_out_of_range = "[This Float is too big, or not a number, to round to an Int]"
// Run-time error: more than 10,000 nested calls, usually runaway recursion
stack_overflow = "[More than 10,000 calls are nested here]"
// Run-time error: the interpreter reached a state it shouldn't, a bug in Check
internal_error = "[This is a bug in Check, not in your code]"
// Error: working out a const or data value at check time took too many steps
out_of_steps = "[This const or data value took too long to work out]"
// Error: a `try` failed while working out a const or data value at check time
data_try_failed = "[A `try` failed while building this data value]"
// Run-time error: reading a map key that isn't there
missing_key = "[This map has no such key]"
// Run-time error: reading a list index that isn't there
index_out_of_range = "[This list has no such index]"
// Run-time error: a `for ref` loop's current item was removed before it could be written back
for_ref_element_gone = "[This item was removed before the `for ref` loop could write it back]"
// Warning: a `var` never changed after it's declared
unused_var = "[This `var` is never changed: make it a `let`]"
// Warning: changing a copy of a value that's never read again
changed_copy = "[This changes a copy that's never used again]"
// Warning: `Shared<T>` where `T` is a `shared class`
shared_wraps_shared_class = "[A shared class is shared already, so it doesn't need `Shared`]"
// Warning: a `ref` parameter whose type is a `shared class`
ref_param_of_shared_class = "[A shared class is shared already, so it doesn't need `ref`]"
// Warning: a local with the same name as a function or type, hiding it
shadowed_name = "[This local hides a function or type with the same name]"
// Warning: a Maybe put inside a string with `{}`, which may print `None`
interpolated_maybe = "[This might be `None`, which prints as `None`]"
// Warning: an expression that gives a `T??`
nested_maybe = "[This gives a `T??`]"
// Warning with a fix: a `let Some(x) = ... else` that `??` can replace
let_else_some = "[`??` can replace this `let Some`-`else`]"
// Warning: a `namespace` line that only repeats its package's namespace
repeated_namespace = "[This namespace only repeats its package's: leave it out]"
// Warning: a variable declared without a value and then set in every branch
set_in_every_branch = "[Every branch sets this, so it can be set where it's declared]"
// Warning: a `try` inside an expression another `try` already covers
nested_try = "[The outer `try` already covers this]"
// Error: `+=` and the like on a map key that might not exist
compound_on_missing_index = "[This index might not exist, so it can't be changed in place]"
// Run-time error: a `ref` argument's place was changed by something else during the call
ref_changed_elsewhere = "[Something else changed this `ref` argument's place during the call]"
// Error: passing a global as `ref` to a function that also changes that global
ref_global_written = "[This function also changes this global, so it can't be passed as `ref`]"
// Warning with a fix: a record literal that repeats the class name it's already typed as
record_beside_class = "[The class is already written beside this record: leave it out]"

// Command line
// `check tidy` when it made changes; {fixes} and {files} are filled with counts
tidy_summary = "[Made {fixes} fixes in {files} files]"
// `check tidy` when errors stop it from applying style fixes
tidy_errors_remain = "[Style fixes were skipped, because there are errors tidy can't fix]"
// `check tidy` when fixes keep producing new fixes after 10 passes
tidy_too_many_passes = "[Tidy stopped after 10 passes with fixes still left, and changed nothing]"
// `check tidy` in dry-run mode when it found fixes
tidy_dry_run = "[Found fixes to make, and left the files unchanged]"
// Run-time error's call stack, in place of the middle calls when it's long; {count} is how many
calls_left_out = "[{count} calls left out]"
// Error when reading a `.con` file into Rust types hits a value it can't convert
con_value_unsupported = "[A `.con` file can't hold this value]"
