{
  "name": "check",
  "displayName": "Check",
  "description": "Syntax highlighting for the Check language",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "check",
      "aliases": ["Check", "check"],
      "extensions": [".check"],
      "configuration": "./language-configuration.json"
    }, {
      "id": "con",
      "aliases": ["Check Object Notation", "con"],
      "extensions": [".con"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "check",
      "scopeName": "source.check",
      "path": "./syntaxes/check.tmLanguage.json"
    }, {
      "language": "con",
      "scopeName": "source.con",
      "path": "./syntaxes/check-object-notation.tmLanguage.json"
    }],
    "configurationDefaults": {
      "[check]": { "editor.tabSize": 2, "editor.insertSpaces": true, "editor.detectIndentation": false },
      "[con]": { "editor.tabSize": 2, "editor.insertSpaces": true, "editor.detectIndentation": false }
    }
  }
}
