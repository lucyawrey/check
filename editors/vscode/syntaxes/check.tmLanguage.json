{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Check",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#expression" }
	],
	"repository": {
		"expression": {
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#strings" },
				{ "include": "#attributes" },
				{ "include": "#numbers" },
				{ "include": "#keywords" },
				{ "include": "#functions" },
				{ "include": "#types" }
			]
		},
		"comments": {
			"name": "comment.line.double-slash.check",
			"match": "//.*$"
		},
		"strings": {
			"patterns": [
				{ "name": "string.quoted.triple.raw.check", "begin": "r\"\"\"", "end": "\"\"\"" },
				{
					"name": "string.quoted.triple.check",
					"begin": "\"\"\"",
					"end": "\"\"\"",
					"patterns": [
						{ "name": "constant.character.escape.check", "match": "\\\\(u\\{[0-9A-Fa-f]*\\}|.)" },
						{
							"name": "meta.interpolation.check",
							"begin": "\\{",
							"end": "\\}",
							"beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.check" } },
							"endCaptures": { "0": { "name": "punctuation.section.interpolation.end.check" } },
							"contentName": "source.check",
							"patterns": [{ "include": "#expression" }]
						}
					
					]
				},
				{ "name": "string.quoted.double.raw.check", "begin": "\\br\"", "end": "\"" },
				{
					"name": "string.quoted.double.check",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{ "name": "constant.character.escape.check", "match": "\\\\(u\\{[0-9A-Fa-f]*\\}|.)" },
						{
							"name": "meta.interpolation.check",
							"begin": "\\{",
							"end": "\\}",
							"beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.check" } },
							"endCaptures": { "0": { "name": "punctuation.section.interpolation.end.check" } },
							"contentName": "source.check",
							"patterns": [{ "include": "#expression" }]
						}
					
					]
				}
			]
		},
		"attributes": {
			"name": "entity.name.function.decorator.check",
			"match": "@[A-Za-z_][A-Za-z0-9_]*"
		},
		"numbers": {
			"name": "constant.numeric.check",
			"match": "\\b(0x[0-9A-Fa-f_]+|0b[01_]+|0o[0-7_]+|(0|[1-9][0-9_]*)(\\.[0-9][0-9_]*)?(e[+-]?[0-9]+)?d?)\\b"
		},
		"keywords": {
			"patterns": [
				{ "name": "keyword.operator.arrow.check", "match": "->" },
				{ "name": "keyword.control.check", "match": "\\b(if|else|match|for|in|while|loop|break|continue|return|try|yield)\\b" },
				{ "name": "keyword.operator.word.check", "match": "\\b(and|or|not|div|mod|as|is)\\b" },
				{ "name": "storage.modifier.check", "match": "\\b(private|readonly|static|ref|shared|effect|attribute|linear|init|external)\\b(?=(\\s+(private|readonly|static|ref|shared|effect|attribute|linear|external))*\\s+(func|class|enum|interface|let|var|const|init)\\b)" },
				{ "name": "storage.modifier.check", "match": "\\binit\\b(?=\\s*\\{)" },
				{ "name": "storage.modifier.check", "match": "\\b(ref|shared)\\b(?=[ \\t]+(this\\b|[a-z_][A-Za-z0-9_]*\\s*(:|=(?!=)|in\\b|\\.|\\)|,|$)))" },
				{ "name": "storage.type.check", "match": "\\b(func|let|var|const|enum|class|interface|implement|import|namespace)\\b" },
				{ "name": "constant.language.check", "match": "\\b(true|false)\\b" },
				{ "name": "variable.language.this.check", "match": "\\bthis\\b" }
			]
		},
		"functions": {
			"patterns": [
				{
					"match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?==\\s*(effect\\s+)?func\\b)",
					"captures": { "1": { "name": "entity.name.function.check" } }
				},
				{
					"match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
					"captures": { "1": { "name": "entity.name.function.check" } }
				}
			]
		},
		"types": {
			"name": "entity.name.type.check",
			"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
		}
	},
	"scopeName": "source.check"
}
