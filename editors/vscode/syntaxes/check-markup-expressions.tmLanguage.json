{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Check Markup with expressions",
	"patterns": [
		{
			"name": "meta.interpolation.cmlx",
			"begin": "\\{",
			"end": "\\}",
			"beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.cmlx" } },
			"endCaptures": { "0": { "name": "punctuation.section.interpolation.end.cmlx" } },
			"patterns": [{ "include": "source.check" }]
		},
		{ "include": "source.cml" }
	],
	"scopeName": "source.cmlx"
}
